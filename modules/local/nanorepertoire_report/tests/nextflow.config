profiles {
  docker {
    docker.enabled = true
    docker.runOptions = '-u \$(id -u):\$(id -g)'
  }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
  }
}

params {
  cdhit_identity  = 0.9
  cdhit_word_size = 5
}

process {
  withLabel:process_single {
    cpus   = 1
    memory = 1.GB
  }
}
