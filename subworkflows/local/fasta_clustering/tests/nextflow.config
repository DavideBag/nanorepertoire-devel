process {
    withName: CDHIT_CDHIT {
        memory = 6.GB
    }
    withName: CUTADAPT {
        cpus = 2
        memory = 6.GB
    }
    withName: NANOCDRX {
        cpus = 2
        memory = 6.GB
    }
    withName: FLASH {
        ext.args = '-m 20 -M 150'
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u \$(id -u):\$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
